# Copie este arquivo para .env (mesma pasta) e preencha. O .env NUNCA vai para o GitHub.

# Meta for Developers > seu app > WhatsApp > Configuração da API
WA_TOKEN=
WA_PHONE_ID=

# Meta for Developers > seu app > Configurações do app > Básico > Chave secreta do app
APP_SECRET=

# Invente uma palavra qualquer e use a mesma no campo "Verificar token" do webhook na Meta
VERIFY_TOKEN=

# Senha do painel do dono (usuário: qualquer um, ex.: dono)
PANEL_PASS=

# Chave Pix mostrada ao hóspede no pedido (use uma de teste na demonstração)
PIX_KEY=pix-de-teste@remansodorio.exemplo
